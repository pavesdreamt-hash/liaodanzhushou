{
  "name": "liaodan-assistant-next",
  "productName": "聊单助手",
  "version": "1.4.5",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "description": "基于确认稿重建的独立聊单助手。",
  "author": "聊单助手",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:shared": "node scripts/whatsapp-compat.mjs && node scripts/build-shared.mjs",
    "check:shared": "node scripts/whatsapp-compat.mjs && node scripts/build-shared.mjs --check",
    "test": "npm run build:shared && node --test --test-timeout=30000 test/*.test.mjs",
    "test:orders": "node --test --test-timeout=30000 test/orders.test.mjs",
    "test:electron-orders": "node --test --test-concurrency=1 --test-timeout=60000 test/electron-order-ui.e2e.mjs test/order-dialog-responsive.e2e.mjs test/electron-browser-workspace.e2e.mjs test/assistant-layout.e2e.mjs",
    "test:electron-real-isolation": "node --test --test-timeout=120000 test/electron-real-isolation.e2e.mjs",
    "orders:preview-shopplus": "node scripts/preview-shopplus.mjs",
    "test:old": "npm --prefix .. test",
    "check": "npm run typecheck && npm run build:ui && npm run check:shared && node scripts/check-project.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "start": "npm run build:ui && electron .",
    "pack": "npm run test && npm run check && electron-builder --config scripts/electron-builder.cjs --mac dir --x64",
    "dist": "npm run build:ui && npm run test && npm run check && electron-builder --config scripts/electron-builder.cjs --mac dir --x64 && node scripts/package-chat-preview.mjs",
    "postinstall": "node scripts/whatsapp-compat.mjs",
    "dist:win": "npm run test && npm run check && node scripts/build-windows-icon.mjs && electron-builder --config scripts/electron-builder-win.cjs --win nsis --x64",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "dev:ui": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "googleapis": "176.0.0",
    "jszip": "3.10.1",
    "lucide-react": "^0.468.0",
    "playwright-core": "1.62.1",
    "qrcode": "1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "whatsapp-web.js": "1.34.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "build": {
    "appId": "com.liaodan.assistant.live",
    "productName": "聊单助手",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "src/**/*",
      "shared/**/*",
      "renderer/**/*",
      "assets/**/*",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/.history/**",
      "!node_modules/**/.git{,/**}",
      "!node_modules/**/test.js",
      "!node_modules/**/test-*.js",
      "!test{,/**}",
      "package.json",
      "USER-GUIDE.md",
      "RELEASE-NOTES.md",
      "THIRD-PARTY-NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources/google-oauth.json",
        "to": "google-oauth.json"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "assets/app-icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "聊单助手${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "聊单助手",
      "sign": false,
      "contents": [
        {
          "x": 140,
          "y": 220
        },
        {
          "x": 420,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
